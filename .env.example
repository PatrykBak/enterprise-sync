COMPOSE_PROJECT_NAME=enterprise_sync

PORT=3000
WORKER_PORT=3001

POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=enterprise_db
DATABASE_URL=postgresql://admin:password@localhost:5432/enterprise_db

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET_NAME=transactions-bucket
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

DEV_SECRET_TOKEN=dev-secret-token
JWT_SECRET=enterprise-sync-jwt-secret-key-change-in-production